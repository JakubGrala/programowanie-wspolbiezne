<Window x:Class="Presentation.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:model="clr-namespace:Presentation.Model"
        xmlns:attached="clr-namespace:Presentation.Attached"
        mc:Ignorable="d"
        Title="Kulki" Height="560" Width="900">
    <Grid Margin="12">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
        </Grid.RowDefinitions>

        <DockPanel Grid.Row="0" Margin="0,0,0,12" LastChildFill="False">
            <StackPanel DockPanel.Dock="Left" Orientation="Horizontal" VerticalAlignment="Center">
                <TextBlock Text="Liczba kul:" VerticalAlignment="Center" Margin="0,0,8,0" />
                <TextBox Width="72"
                         Text="{Binding BallCountText, UpdateSourceTrigger=PropertyChanged}"
                         VerticalAlignment="Center" />
                <Button Content="Zastosuj"
                        Margin="12,0,0,0"
                        Padding="12,6"
                        Command="{Binding ApplyBallsCommand}" />
            </StackPanel>
            <StackPanel DockPanel.Dock="Right" Orientation="Horizontal">
                <Button Content="Start"
                        Margin="0,0,8,0"
                        Padding="12,6"
                        Command="{Binding StartSimulationCommand}" />
                <Button Content="Stop"
                        Padding="12,6"
                        Command="{Binding StopSimulationCommand}" />
            </StackPanel>
        </DockPanel>

        <Border Grid.Row="1"
                attached:PlayfieldSizeObserver.Observe="True"
                BorderBrush="DimGray"
                BorderThickness="1"
                Background="#FFFAFAFA"
                ClipToBounds="True">
            <ItemsControl ItemsSource="{Binding SimulationModel.Balls}">
                <ItemsControl.ItemsPanel>
                    <ItemsPanelTemplate>
                        <Canvas Background="White" />
                    </ItemsPanelTemplate>
                </ItemsControl.ItemsPanel>
                <ItemsControl.ItemContainerStyle>
                    <Style TargetType="ContentPresenter">
                        <Setter Property="Canvas.Left" Value="{Binding DisplayLeft}" />
                        <Setter Property="Canvas.Top" Value="{Binding DisplayTop}" />
                    </Style>
                </ItemsControl.ItemContainerStyle>
                <ItemsControl.ItemTemplate>
                    <DataTemplate DataType="{x:Type model:BallDisplayModel}">
                            <Ellipse Width="{Binding DisplayDiameter}"
                                     Height="{Binding DisplayDiameter}"
                                     Fill="{Binding Fill}"
                                     Stroke="MidnightBlue"
                                     StrokeThickness="1.5" />
                    </DataTemplate>
                </ItemsControl.ItemTemplate>
            </ItemsControl>
        </Border>
    </Grid>
</Window>
